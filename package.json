{
  "name": "beontech-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress + TypeScript challenge: Restful-Booker API and SauceDemo UI",
  "scripts": {
    "test": "cypress run --headless",
    "test:all": "cypress run --headless",
    "test:api": "cypress run --headless --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "test:ui": "cypress run --headless --spec \"cypress/e2e/ui/**/*.cy.ts\"",
    "test:ui:headed": "cypress run --headed --spec \"cypress/e2e/ui/**/*.cy.ts\"",
    "all": "npm run test:all",
    "api": "npm run test:api",
    "ui": "npm run test:ui",
    "open": "cypress open",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:names": "ls-lint",
    "audit": "npm audit --audit-level=high",
    "summary": "node scripts/ci-summary.mjs",
    "check": "npm run format:check && npm run lint && npm run lint:names && npm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@types/node": "^26.6.6",
    "cypress": "^16.3.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^7.0.4",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2"
  }
}
